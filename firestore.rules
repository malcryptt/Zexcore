rules_version = '2';

// ZexCore on Firebase. There is no application server: THESE RULES ARE THE SECURITY BOUNDARY.
//
// Model (everything for one business lives under workspaces/{wid}):
//   slugs/{slug}                         public lookup + public booking-page profile (owner maintained)
//   users/{uid}                          the signed-in user's own profile
//   workspaces/{wid}                     plan fields are NEVER writable from a client (only the payment Worker,
//                                        which uses a service account and bypasses these rules)
//   workspaces/{wid}/members/{uid}       role: owner | admin | staff (created only together with the workspace)
//   workspaces/{wid}/services|staff|contacts|pages/{kind_N}
//                                        document ids are numbered slots (e.g. s_0 .. s_{limit-1}); the plan
//                                        limit is enforced by refusing ids at or above it. Race-free, no counters.
//   workspaces/{wid}/bookings/{YYYYMM_N} same idea per calendar month (bookings created this month <= limit)
//   workspaces/{wid}/locks/{staff_cell}  create-only 15-minute cells; a second booking of a cell is refused,
//                                        which is what prevents double booking without a server.
//
// Plan limits mirror packages/core/src/billing/limits.ts. Grace: 3 days after plan expiry, then free.

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────── helpers ─────────────
    function signedIn() { return request.auth != null; }
    function wsPath(wid) { return /databases/$(database)/documents/workspaces/$(wid); }
    function memberPath(wid, uid) { return /databases/$(database)/documents/workspaces/$(wid)/members/$(uid); }
    function isMember(wid) { return signedIn() && exists(memberPath(wid, request.auth.uid)); }
    function memberRole(wid) { return get(memberPath(wid, request.auth.uid)).data.role; }
    function isAdmin(wid) { return isMember(wid) && memberRole(wid) in ['owner', 'admin']; }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function noExtraKeys(allowed) { return request.resource.data.keys().hasOnly(allowed); }

    function isAdminEmail() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() in ['hellozexcore@gmail.com', 'hellozexlabs@gmail.com'];
    }

    function planOf(wid) {
      let w = get(wsPath(wid)).data;
      return isAdminEmail() ? 'enterprise' : ((w.plan == 'free' || w.get('planExpiresAt', null) == null
              || request.time < w.planExpiresAt + duration.value(3, 'd')) ? w.plan : 'free');
    }
    function hasStarter(wid) {
      return planOf(wid) in ['starter', 'growth', 'agency', 'enterprise', 'dedicated'];
    }
    function hasGrowth(wid) {
      return planOf(wid) in ['growth', 'agency', 'enterprise', 'dedicated'];
    }
    function limitOf(wid, key) {
      return {
        'free':       {'bookingsPerMonth': 30,   'staff': 1,   'services': 3,   'cmsPages': 3,   'crmContacts': 50, 'devices': 0, 'rules': 0},
        'starter':    {'bookingsPerMonth': 200,  'staff': 3,   'services': 10,  'cmsPages': 10,  'crmContacts': 500, 'devices': 0, 'rules': 0},
        'growth':     {'bookingsPerMonth': 1000, 'staff': 10,  'services': 30,  'cmsPages': 50,  'crmContacts': 5000, 'devices': 25, 'rules': 25},
        'agency':     {'bookingsPerMonth': 5000, 'staff': 50,  'services': 100, 'cmsPages': 200, 'crmContacts': 50000, 'devices': 100, 'rules': 100},
        'enterprise': {'bookingsPerMonth': 999999, 'staff': 999999, 'services': 999999, 'cmsPages': 999999, 'crmContacts': 999999, 'devices': 999999, 'rules': 999999},
        'dedicated':  {'bookingsPerMonth': 999999, 'staff': 999999, 'services': 999999, 'cmsPages': 999999, 'crmContacts': 999999, 'devices': 999999, 'rules': 999999}
      }.get(planOf(wid), {'bookingsPerMonth': 30, 'staff': 1, 'services': 3, 'cmsPages': 3, 'crmContacts': 50, 'devices': 0, 'rules': 0})[key];
    }
    // "<prefix>_<n>" with n below the plan limit for this resource
    function slotId(wid, prefix, key, id) {
      return id.matches('^' + prefix + '_[0-9]{1,6}$') && int(id.split('_')[1]) < limitOf(wid, key);
    }

    // ───────────── public booking-page lookup ─────────────
    match /slugs/{slug} {
      allow get: if true;
      allow list: if false;
      // claim a slug together with creating its workspace; never overwritten or deleted by clients
      allow create: if signedIn()
        && slug.matches('^[a-z0-9]([a-z0-9-]{1,38})[a-z0-9]$')
        && !(slug in ['admin','api','app','www','signin','signup','login','pricing','security','contact','privacy','terms','docs',
                      'about','console','dashboard','platform','solutions','modules','architecture','resources','book','b','static',
                      'assets','zexcore','mail','support','help','status','product','home','multi-tenancy','automation',
                      'forgot-password','reset-password','verify-email'])
        && request.resource.data.wid is string
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(wsPath(request.resource.data.wid)).data.ownerUid == request.auth.uid
        && getAfter(wsPath(request.resource.data.wid)).data.slug == slug
        && noExtraKeys(['wid', 'ownerUid', 'name', 'timezone', 'currency', 'bookingEnabled', 'slotMinutes',
                        'openMinutes', 'closeMinutes', 'closedWeekdays', 'depositNote', 'phone', 'address',
                        'bookingCap', 'leadMinutes', 'maxDaysAhead', 'depositEnabled', 'depositMinor', 'exchangeRate']);
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.wid == resource.data.wid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && noExtraKeys(['wid', 'ownerUid', 'name', 'timezone', 'currency', 'bookingEnabled', 'slotMinutes',
                        'openMinutes', 'closeMinutes', 'closedWeekdays', 'depositNote', 'phone', 'address',
                        'bookingCap', 'leadMinutes', 'maxDaysAhead', 'depositEnabled', 'depositMinor', 'exchangeRate']);
      allow delete: if false;
    }

    // ───────────── users ─────────────
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && noExtraKeys(['name', 'email', 'phone', 'workspaceIds', 'createdAt'])
        && request.resource.data.workspaceIds is list && request.resource.data.workspaceIds.size() <= 5;
      allow delete: if false;
    }

    // ───────────── workspaces ─────────────
    match /workspaces/{wid} {
      allow get: if isMember(wid);
      allow list: if false;

      allow create: if signedIn()
        && wid.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.ownerUid == request.auth.uid
        && (isAdminEmail() ? request.resource.data.plan in ['free', 'enterprise'] : request.resource.data.plan == 'free')
        && (!('planExpiresAt' in request.resource.data) || isAdminEmail())
        && request.resource.data.slug is string
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 120
        && existsAfter(memberPath(wid, request.auth.uid))
        && getAfter(memberPath(wid, request.auth.uid)).data.role == 'owner'
        && noExtraKeys(['name', 'slug', 'ownerUid', 'plan', 'createdAt', 'settings']);

      // plan / planExpiresAt / ownerUid / slug are immutable for clients, unless admin
      allow update: if (isAdmin(wid) && onlyChanges(['name', 'settings'])
        && (!('settings' in request.resource.data)
            || !('logoUrl' in request.resource.data.settings)
            || request.resource.data.settings.logoUrl == null
            || request.resource.data.settings.logoUrl == ''
            || hasStarter(wid)))
        || (isAdminEmail() && isMember(wid));
      allow delete: if false;

      match /members/{uid} {
        allow read: if isMember(wid);
        // only the founding owner row, written in the same batch as the workspace
        allow create: if signedIn() && uid == request.auth.uid && request.resource.data.role == 'owner'
          && !exists(wsPath(wid))
          && existsAfter(wsPath(wid))
          && getAfter(wsPath(wid)).data.ownerUid == request.auth.uid
          && noExtraKeys(['role', 'name', 'email', 'createdAt']);
        allow update, delete: if false;
      }

      // Visible to the public booking page (names, durations, prices); admins manage them
      match /services/{id} {
        allow get, list: if true;
        allow create: if isAdmin(wid) && slotId(wid, 's', 'services', id);
        allow update, delete: if isAdmin(wid);
      }
      match /staff/{id} {
        allow get, list: if true;
        allow create: if isAdmin(wid) && slotId(wid, 'p', 'staff', id);
        allow update, delete: if isAdmin(wid);
      }

      match /contacts/{id} {
        allow read: if isMember(wid);
        allow create: if isMember(wid) && slotId(wid, 'c', 'crmContacts', id);
        allow update, delete: if isMember(wid);
      }
      match /stages/{id} { allow read, write: if isAdmin(wid); allow read: if isMember(wid); }
      match /leads/{id}  { allow read, write: if isMember(wid); }
      match /customers/{id} { allow read, write: if isMember(wid); }

      // Website pages: published pages are public
      match /pages/{id} {
        allow get, list: if resource.data.published == true || isMember(wid);
        allow create: if isAdmin(wid) && slotId(wid, 'g', 'cmsPages', id);
        allow update, delete: if isAdmin(wid);
      }

      // Bookings: staff manage freely; the public may only CREATE, never read or change
      match /bookings/{id} {
        allow read: if isMember(wid);
        allow update, delete: if isMember(wid);

        allow create: if (isMember(wid) || publicBookingOk(wid)) && bookingSlotOk(wid, id);
      }

      // Time cells: create-only. The booking batch must create every cell it occupies.
      match /locks/{cell} {
        // A cell can be looked up by its exact id (so the public page can grey out taken times) but never listed.
        // It reveals only that a time is taken, and the id of a booking that nobody but staff can read.
        allow get: if true;
        allow list: if false;
        // The cell must belong to a booking that is being CREATED in this same batch (not a guessable old one),
        // for that booking's staff member, so nobody can litter the calendar with junk locks.
        allow create: if request.resource.data.keys().hasOnly(['bookingId', 'createdAt'])
          && request.resource.data.createdAt == request.time
          && !exists(bookingPath(wid, request.resource.data.bookingId))
          && existsAfter(bookingPath(wid, request.resource.data.bookingId))
          && cell.split('_').size() == 3
          && cell.split('_')[0] + '_' + cell.split('_')[1] == getAfter(bookingPath(wid, request.resource.data.bookingId)).data.staffId
          && int(cell.split('_')[2]) in getAfter(bookingPath(wid, request.resource.data.bookingId)).data.cells;
        allow delete: if isMember(wid);   // staff cancelling a booking frees its cells
        allow update: if false;
      }

      // Plan payments. Created, and later marked paid, only by the payments Worker (service account, bypasses
      // rules) after it prices the plan itself and verifies the charge with Paystack. Clients can only read them.
      match /payments/{ref} {
        allow read: if isAdmin(wid);
        allow write: if false;
      }

      // Devices. Admins register them (numbered slots enforce the plan limit) and rotate their token; only the Worker
      // records readings and "last seen", so a browser can never fake telemetry. The token itself is never stored,
      // only its SHA-256 hash.
      match /devices/{id} {
        allow read: if isMember(wid);
        allow create: if isAdmin(wid) && hasGrowth(wid) && slotId(wid, 'd', 'devices', id)
          && noExtraKeys(['name', 'deviceKey', 'kind', 'tokenHash', 'createdAt', 'seq'])
          && request.resource.data.tokenHash.matches('^[a-f0-9]{64}$') && request.resource.data.createdAt == request.time;
        allow update: if isAdmin(wid) && onlyChanges(['name', 'tokenHash'])
          && request.resource.data.tokenHash.matches('^[a-f0-9]{64}$');
        allow delete: if isAdmin(wid);
        match /readings/{rid} {
          allow read: if isMember(wid);
          allow delete: if isAdmin(wid);
          allow write: if false;
        }
      }
      match /alertRules/{id} {
        allow read: if isMember(wid);
        allow create: if isAdmin(wid) && hasGrowth(wid) && noExtraKeys(['deviceId', 'metric', 'op', 'threshold', 'severity', 'message', 'enabled', 'createdAt', 'lastFiredAt'])
          && request.resource.data.op in ['gt', 'gte', 'lt', 'lte', 'eq'] && request.resource.data.threshold is number
          && request.resource.data.severity in ['low', 'medium', 'high', 'critical'] && request.resource.data.createdAt == request.time;
        allow update: if isAdmin(wid) && onlyChanges(['enabled']);
        allow delete: if isAdmin(wid);
      }
      match /alerts/{id} { allow read: if isMember(wid); allow delete: if isAdmin(wid); allow write: if false; }

      // Automations. Anyone on the team may draft a rule; only an admin can approve it, and nothing runs until then.
      // Runs are written by the Worker.
      match /rules/{id} {
        allow read: if isMember(wid);
        allow create: if isMember(wid) && hasGrowth(wid) && slotId(wid, 'r', 'rules', id)
          && noExtraKeys(['name', 'description', 'trigger', 'conditions', 'actions', 'enabled', 'approved', 'createdAt', 'createdBy', 'seq', 'lastRunAt'])
          && request.resource.data.approved == false && request.resource.data.enabled == false
          && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
          && request.resource.data.actions is list && request.resource.data.actions.size() >= 1 && request.resource.data.actions.size() <= 3;
        allow update: if isAdmin(wid) && onlyChanges(['approved', 'enabled', 'approvedBy']);
        allow delete: if isMember(wid);
      }
      match /automationRuns/{id} { allow read: if isAdmin(wid); allow write: if false; }
      match /automationMarkers/{id} { allow read, write: if false; }

      // Where deposits are paid out, and the deposit payments themselves: written only by the Worker (service account).
      match /payout/{id} { allow read: if isAdmin(wid); allow write: if false; }
      match /depositPayments/{ref} { allow read: if isAdmin(wid); allow write: if false; }

      // Inbox: replies the team sends (and customer replies they log), and which conversations have been read.
      match /messages/{id} {
        allow read: if isMember(wid);
        allow create: if isMember(wid) && noExtraKeys(['phone', 'name', 'direction', 'kind', 'body', 'createdAt', 'by'])
          && request.resource.data.phone.matches('^\\+[0-9]{8,15}$')
          && request.resource.data.direction in ['in', 'out'] && request.resource.data.kind == 'text'
          && request.resource.data.body is string && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 2000
          && request.resource.data.name is string && request.resource.data.name.size() <= 160
          && request.resource.data.createdAt == request.time && request.resource.data.by == request.auth.uid;
        allow update: if false;
        allow delete: if isAdmin(wid);       // data-protection erasure and retention
      }
      match /convState/{phone} {
        allow read: if isMember(wid);
        allow delete: if isAdmin(wid);
        allow create, update: if isMember(wid) && phone.matches('^\\+[0-9]{8,15}$') && noExtraKeys(['readAt']) && request.resource.data.readAt == request.time;
      }

      // Data protection (admins only except consent, which any member may record)
      match /retention/{entity} {
        allow read, delete: if isAdmin(wid) && hasStarter(wid);
        allow create, update: if isAdmin(wid) && hasStarter(wid) && entity in ['messages', 'bookings'] && noExtraKeys(['retentionDays', 'enabled', 'lastRunAt'])
          && request.resource.data.retentionDays is int && request.resource.data.retentionDays >= 1 && request.resource.data.retentionDays <= 3650;
      }
      match /erasures/{id} {
        allow read, create: if isAdmin(wid) && hasStarter(wid);
        allow update: if isAdmin(wid) && hasStarter(wid) && onlyChanges(['status', 'completedAt', 'summary']);
        allow delete: if false;
      }
      match /consents/{id} {
        allow read: if isMember(wid) && hasStarter(wid);
        allow create: if isMember(wid) && hasStarter(wid) && noExtraKeys(['subjectId', 'purpose', 'legalBasis', 'grantedAt', 'revokedAt', 'by'])
          && request.resource.data.grantedAt == request.time && request.resource.data.by == request.auth.uid && request.resource.data.revokedAt == null;
        allow update: if isMember(wid) && hasStarter(wid) && onlyChanges(['revokedAt']) && request.resource.data.revokedAt == request.time;
        allow delete: if isAdmin(wid) && hasStarter(wid);
      }

      // Tamper-evident audit trail. Written ONLY by the Worker (service account), which chains each entry to the
      // previous one and takes the actor from the verified ID token. Admins can read it; nobody can write it here.
      match /auditChain/{id} { allow read: if isAdmin(wid); allow write: if false; }
      match /auditMeta/{id}  { allow read: if isAdmin(wid); allow write: if false; }
      match /audit/{id}      { allow read: if isAdmin(wid); allow write: if false; }   // legacy entries
    }

    // Public booking validation ------------------------------------------------------------------------------
    function bookingSlotOk(wid, id) {
      // <YYYYMM>_<n>, month = now, n below the plan's monthly limit
      return id.matches('^[0-9]{6}_[0-9]{1,6}$')
        && id.split('_')[0] == string(request.time.year() * 100 + request.time.month())
        && int(id.split('_')[1]) < limitOf(wid, 'bookingsPerMonth');
    }
    function bookingPath(wid, bid) { return /databases/$(database)/documents/workspaces/$(wid)/bookings/$(bid); }
    function cellDoc(wid, staffId, cell) {
      return /databases/$(database)/documents/workspaces/$(wid)/locks/$(staffId + '_' + string(cell));
    }
    function cellOk(wid, d, i) {
      return d.cells.size() <= i || (d.cells[i] == d.cells[0] + i && existsAfter(cellDoc(wid, d.staffId, d.cells[i])));
    }
    function publicBookingOk(wid) {
      let d = request.resource.data;
      let svc = get(/databases/$(database)/documents/workspaces/$(wid)/services/$(d.serviceId)).data;
      return d.keys().hasOnly(['serviceId', 'staffId', 'customerName', 'customerPhone', 'customerEmail', 'notes',
                              'startsAt', 'endsAt', 'cells', 'status', 'source', 'createdAt'])
        && d.status == 'pending' && d.source == 'public' && d.createdAt == request.time
        && d.customerName is string && d.customerName.size() >= 2 && d.customerName.size() <= 120
        && d.customerPhone is string && d.customerPhone.matches('^\\+[0-9]{8,15}$')
        && d.startsAt is timestamp && d.endsAt is timestamp && d.startsAt > request.time
        && d.startsAt < request.time + duration.value(180, 'd')
        && svc.active == true
        && d.endsAt.toMillis() - d.startsAt.toMillis() == svc.durationMin * 60000
        && exists(/databases/$(database)/documents/workspaces/$(wid)/staff/$(d.staffId))
        && d.cells is list && d.cells.size() * 15 == svc.durationMin && d.cells.size() >= 1 && d.cells.size() <= 8
        && d.cells[0] * 900000 == d.startsAt.toMillis()
        && cellOk(wid, d, 1) && cellOk(wid, d, 2) && cellOk(wid, d, 3) && cellOk(wid, d, 4)
        && cellOk(wid, d, 5) && cellOk(wid, d, 6) && cellOk(wid, d, 7)
        && existsAfter(cellDoc(wid, d.staffId, d.cells[0]));
    }

    // everything else is closed
    match /{document=**} { allow read, write: if false; }
  }
}
