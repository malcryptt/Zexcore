# Environment Mode
NODE_ENV=development

# Server Configuration
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL with RLS)
DATABASE_URL=postgres://zexcore_app:zexcore_secret@localhost:5433/zexcore_db
ADMIN_DATABASE_URL=postgres://zexcore_owner:zexcore_owner_secret@localhost:5433/zexcore_db

# Security & Authentication
JWT_SECRET=zexcore-development-jwt-secret-key-at-least-32-chars-long
SESSION_TTL_HOURS=24

# Logging
LOG_LEVEL=info

# AI Authoring (rules engine — POST /api/rules/ai-draft)
# Get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Production-required (compose refuses to start without the first two) ---
# POSTGRES_PASSWORD=     # bootstrap superuser password (compose only)
# ZEX_OWNER_PASSWORD=    # schema-owner role: boot-time migrations only
# ZEX_APP_PASSWORD=      # restricted runtime role: serves requests
# ADMIN_DATABASE_URL=postgres://zexcore_owner:...@host/db   # REQUIRED in production, must differ from DATABASE_URL
# NGN_PER_USD=1500       # server-side NGN price conversion
# JWT_SECRET=            # >= 32 random chars: openssl rand -hex 32
# TRUST_PROXY=true       # set when behind Render/Railway/nginx so rate limiting sees real client IPs
# Billing webhooks fail closed (503) until their secret is set:
# PAYSTACK_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# FLUTTERWAVE_SECRET_HASH=

# Google sign-in (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID, type "Web application").
# Add your site origin(s) under "Authorized JavaScript origins". Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# Public key shown to browsers for Paystack Inline checkout (pk_live_... / pk_test_...). Deposits and plan upgrades need it.
# PAYSTACK_PUBLIC_KEY=
# Public site origin, used to build payment links sent to customers (no trailing slash).
# PUBLIC_APP_URL=https://zexcore.com.ng
# Optional: serve each business at <slug>.<base domain>. Leave unset to use zexcore.com.ng/<slug> only.
# TENANT_BASE_DOMAIN=
