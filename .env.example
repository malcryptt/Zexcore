# Environment Mode
NODE_ENV=development

# Server Configuration
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL with RLS)
DATABASE_URL=postgres://zexcore_app:zexcore_secret@localhost:5433/zexcore_db

# Security & Authentication
JWT_SECRET=zexcore-development-jwt-secret-key-at-least-32-chars-long
SESSION_TTL_HOURS=24

# Logging
LOG_LEVEL=info

# AI Authoring (rules engine — POST /api/rules/ai-draft)
# Get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
