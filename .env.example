# Environment Mode
NODE_ENV=development

# Server Configuration
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL with RLS)
DATABASE_URL=postgres://zexcore_app:zexcore_secret@localhost:5433/zexcore_db

# Security & Authentication
JWT_SECRET=zexcore-development-jwt-secret-key-at-least-32-chars-long
SESSION_TTL_HOURS=24

# Logging
LOG_LEVEL=info

# AI Authoring (rules engine — POST /api/rules/ai-draft)
# Get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Production-required (compose refuses to start without the first two) ---
# POSTGRES_PASSWORD=
# JWT_SECRET=            # >= 32 random chars: openssl rand -hex 32
# TRUST_PROXY=true       # set when behind Render/Railway/nginx so rate limiting sees real client IPs
# Billing webhooks fail closed (503) until their secret is set:
# PAYSTACK_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# FLUTTERWAVE_SECRET_HASH=
